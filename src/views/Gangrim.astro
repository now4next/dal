---
import Base from '../layouts/Base.astro';
import Briefing from './Briefing.astro';
import director from '../data/director.json';
import type {Lang} from '../lib/i18n';
interface Props {lang:Lang}
const {lang}=Astro.props;
const api=import.meta.env.PUBLIC_GANGRIM_API_URL||'';
---
<Base lang={lang} path="/gangrim/" title="강림선생 · 대표 보고" description="AI 경영자와 보고를 준비하고 준비도 95점 이상일 때 대표에게 전달합니다." section="gangrim">
  <div class="gangrim wrap" data-api={api}>
    <header class="report-app-header"><img src={director.photo.src} alt="강림선생" width="44" height="44"/><div><h1>강림선생</h1><p>AI 경영자와 대표 보고를 준비합니다.</p></div><span id="connection" class="connection-pill" role="status">연결 중</span></header>
    <nav class="report-tabs" role="tablist" aria-label="보고 메뉴"><button type="button" role="tab" aria-selected="true" data-panel="briefing-panel">보고 대화</button><button type="button" role="tab" aria-selected="false" data-panel="projects-panel">보고 프로젝트</button><button type="button" role="tab" aria-selected="false" data-panel="owner-panel">대표 검토함</button></nav>
    <Briefing/>
    <section id="owner-panel" role="tabpanel" hidden><div class="report-heading"><div><span class="eyebrow">대표 검토함</span><h2>보고와 의사결정</h2></div></div><form id="owner-form" class="owner-login"><label>대표 인증키<input id="owner-key" type="password" autocomplete="off" required/></label><button class="btn sec" type="submit">검토함 열기</button></form><p id="owner-status" class="quiet-status" role="status"></p><div id="owner-queue" class="projects-list"></div><div id="owner-result" class="owner-report" hidden></div></section>
  </div>
  <script>import '../scripts/gangrim';</script>
</Base>
<style is:global>
.gangrim section{padding-block:0}.gangrim .decision-result{padding:18px}
.gangrim{padding-top:32px;padding-bottom:80px}.gangrim [hidden]{display:none!important}.report-app-header{display:flex;align-items:center;gap:13px;padding-bottom:24px}.report-app-header img{width:44px;height:44px;border-radius:12px;object-fit:cover}.report-app-header h1{font-size:24px;line-height:1.3;margin:0}.report-app-header p{font-size:13px;color:var(--fg-3);margin:5px 0 0}.connection-pill{margin-left:auto;font-size:11px;color:var(--mint);white-space:nowrap}.report-tabs{display:flex;gap:6px;border-bottom:1px solid var(--line);margin-bottom:28px;overflow-x:auto}.report-tabs button{border:0;border-bottom:2px solid transparent;padding:15px 18px;background:transparent;color:var(--fg-3);font:500 14px var(--font);white-space:nowrap;cursor:pointer}.report-tabs button[aria-selected=true]{color:var(--fg);border-bottom-color:var(--accent)}.report-heading{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:24px}.report-heading h2{font-size:24px;line-height:1.45;margin-top:8px;overflow-wrap:anywhere}.report-heading .eyebrow{font-size:10px}.report-layout{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(280px,1fr);gap:32px;align-items:start}.report-conversation{min-width:0}#briefing-log{display:flex;flex-direction:column;gap:18px}.gangrim .chat-message{padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--surface);scroll-margin-top:100px}.gangrim .chat-user{margin-left:28px;background:#1c1233}.gangrim .chat-ai{margin-right:12px;border-left:3px solid var(--accent)}.gangrim .chat-speaker{font-size:11px;color:var(--fg-3);display:block;margin-bottom:10px}.gangrim .chat-question{font-size:20px;line-height:1.65;font-weight:600;color:var(--fg);white-space:pre-wrap}.gangrim .chat-message p,.gangrim .chat-message li{font-size:14px;line-height:1.85;white-space:pre-wrap;overflow-wrap:anywhere}.gangrim .chat-message .chat-weakness{font-size:13px;color:var(--fg-2);margin-bottom:14px}.gangrim .chat-message .chat-score{font-size:12px;color:var(--mint);margin-top:16px}.gangrim details{border-top:1px solid var(--line);padding-top:16px;margin-top:18px}.gangrim summary{cursor:pointer;font-size:13px;line-height:1.7;font-weight:500}.gangrim details p,.gangrim details li{font-size:13px;color:var(--fg-2);line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere}.gangrim details h4{font-size:13px;margin:17px 0 8px;color:var(--accent-3)}.gangrim ul,.gangrim ol{padding-left:20px}.gangrim .report-info{border:0;margin:8px 0 14px;padding:0}.gangrim .report-info p{font-size:12px}.gangrim label{display:flex;flex-direction:column;gap:8px;font-size:13px;font-weight:500}.gangrim label+label{margin-top:14px}.gangrim input:not([type=checkbox]),.gangrim textarea,.gangrim select{width:100%;min-width:0;min-height:44px;color:var(--fg);background:#0e0823;border:1px solid var(--line-2);border-radius:9px;padding:11px 13px;font:400 14px/1.7 var(--font)}.gangrim textarea{resize:vertical}.gangrim input::placeholder,.gangrim textarea::placeholder{color:#9c93b5}.gangrim input:focus-visible,.gangrim textarea:focus-visible,.gangrim select:focus-visible,.gangrim button:focus-visible{outline:2px solid var(--accent-3);outline-offset:3px}.gangrim .check-line{flex-direction:row;align-items:flex-start;gap:9px;line-height:1.7;font-size:12px;font-weight:400;margin-top:14px}.gangrim input[type=checkbox]{margin-top:4px;accent-color:var(--accent);flex-shrink:0}.gangrim .report-composer{margin-top:22px;border:1px solid var(--line-2);border-radius:14px;padding:18px;background:var(--surface)}.gangrim #briefing-title{margin-bottom:12px}.gangrim .report-composer textarea{border:0;background:transparent;padding:4px;min-height:120px}.composer-tools{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:15px}.gangrim .attach-label{font-size:12px;max-width:65%;min-width:0}.gangrim .attach-label input[type=file]{min-height:34px;padding:5px;font-size:10px;max-width:100%}.gangrim small{font-size:11px;line-height:1.8;color:var(--fg-3);display:block;margin-top:9px}.gangrim .quiet-status{font-size:12px;line-height:1.8;color:var(--mint);white-space:pre-wrap;margin:15px 0;overflow-wrap:anywhere}.gangrim .chat-footer{display:flex;justify-content:space-between;gap:12px;margin-top:12px}.gangrim .text-button{font:400 12px/1.8 var(--font);color:var(--fg-3);background:none;border:0;padding:0;cursor:pointer;text-decoration:none}.gangrim .text-button:hover{color:var(--accent-3)}.readiness-card{position:sticky;top:100px;background:linear-gradient(145deg,#211438,#10091f);border:1px solid var(--line-2);border-radius:16px;padding:26px;max-height:calc(100vh - 120px);overflow:auto;min-width:0}.readiness-card .eyebrow{font-size:11px}.score-number{margin:18px 0 8px;display:flex;align-items:baseline;gap:8px}.score-number strong{font-size:54px;line-height:1.1;letter-spacing:-.04em}.score-number span{font-size:14px;color:var(--fg-3)}#readiness-guide{font-size:12px;color:var(--fg-2);line-height:1.8;margin-bottom:20px}.readiness-card .btn{width:100%;justify-content:center;white-space:normal;text-align:center}.readiness-card>.text-button{display:block;margin-top:22px}.gangrim .score-item{padding:10px 0;border-bottom:1px solid var(--line)}.gangrim .score-item h4{font-size:12px;line-height:1.7;color:var(--fg);margin:0 0 8px}.score-item meter{width:100%;height:7px;accent-color:var(--accent)}.gangrim .score-item p,.gangrim .score-item li{font-size:12px;line-height:1.8;color:var(--fg-2)}.score-caption{font-size:13px;color:var(--mint)}.gangrim button:disabled{opacity:.42;cursor:not-allowed}.gangrim .btn{font-size:13px}.projects-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.project-card{border:1px solid var(--line-2);border-radius:14px;padding:23px;background:var(--surface);min-width:0}.project-card h3{font-size:17px;line-height:1.6;overflow-wrap:anywhere}.project-card p{font-size:12px;line-height:1.8;color:var(--fg-3);margin:10px 0 18px}.gangrim .project-state-button{width:100%;background:#24143e;border:1px solid #604087;border-radius:9px;color:var(--fg);padding:12px 14px;text-align:left;font:500 13px/1.7 var(--font);cursor:pointer;white-space:normal}.project-state-button[data-result=true]{border-color:var(--mint);color:var(--mint)}.project-storage{margin-top:30px!important}.project-storage form{display:grid;grid-template-columns:1fr 1fr auto;gap:15px;align-items:end;margin:18px 0}.project-storage form label+label{margin-top:0}.project-storage .attach-label{margin-top:18px}.report-dialog{width:min(760px,calc(100vw - 24px));max-height:calc(100dvh - 40px);background:#140b27;border:1px solid var(--line-2);border-radius:18px;padding:30px;color:var(--fg);margin:auto;overflow:auto}.report-dialog::backdrop{background:#050210bb;backdrop-filter:blur(4px)}.gangrim .dialog-close{display:block;margin:0 0 20px auto;color:var(--fg-3);background:none;border:0;font:400 12px var(--font);cursor:pointer}.gangrim .report-dialog h2,.gangrim .owner-report h2{font-size:24px;line-height:1.5;margin-bottom:16px}.gangrim .report-dialog h3,.gangrim .owner-report h3{font-size:16px;margin:24px 0 10px}.gangrim .report-dialog p,.gangrim .owner-report p{font-size:14px;line-height:1.9;white-space:pre-wrap;overflow-wrap:anywhere}.project-meta{font-size:12px!important;color:var(--fg-3)}.decision-result{padding:18px;background:#24163c;border-radius:12px;margin:20px 0}.decision-result h3{margin-top:0!important}.decision-result strong{color:var(--mint)}.gangrim .attachment-button{display:block;width:100%;background:none;border:1px solid var(--line-2);padding:12px 14px;text-align:left;border-radius:8px;color:var(--accent-3);font:400 13px/1.7 var(--font);margin-top:10px;cursor:pointer;overflow-wrap:anywhere}.dialog-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}.gangrim #handoff-form{margin-top:26px;border-top:1px solid var(--line);padding-top:22px}.gangrim #handoff-form>.btn{margin-top:18px}.owner-login{display:flex;align-items:end;gap:16px;max-width:620px}.owner-login label{flex:1}.owner-report{margin-top:30px;border-top:1px solid var(--line);padding-top:30px}.owner-actions{margin-top:25px}.owner-actions label{margin-top:20px}.gangrim .sr-label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
@media(max-width:800px){.gangrim{padding-top:22px}.report-app-header h1{font-size:21px}.report-app-header p{font-size:11px}.report-app-header img{width:38px;height:38px}.connection-pill{font-size:10px}.report-tabs button{padding:13px 12px;font-size:13px}.report-heading{margin-bottom:20px}.report-heading h2{font-size:21px}.report-layout{grid-template-columns:1fr;gap:22px}.readiness-card{order:-1;position:static;max-height:none;padding:18px;display:grid;grid-template-columns:1fr 1fr;gap:8px 18px;align-items:center}.readiness-card .eyebrow{grid-column:1/-1}.score-number{margin:0}.score-number strong{font-size:36px}#readiness-guide{grid-column:1;margin:0;font-size:10px}.readiness-card>.btn{grid-column:2;grid-row:2/4}.readiness-card>details,.readiness-card>.text-button{grid-column:1/-1}.readiness-card>details{margin-top:8px;padding-top:10px}.readiness-card>.text-button{margin-top:6px}.projects-list{grid-template-columns:1fr}.project-storage form{grid-template-columns:1fr}.report-dialog{padding:22px}.gangrim .chat-message{padding:18px}.gangrim .chat-question{font-size:18px}.gangrim .chat-user{margin-left:14px}.gangrim .chat-ai{margin-right:0}.owner-login{flex-direction:column;align-items:stretch}.gangrim .attach-label{max-width:60%}.composer-tools .btn{font-size:12px;flex-shrink:0}}
</style>
