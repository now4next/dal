---
import Base from '../layouts/Base.astro';
import Briefing from './Briefing.astro';
import director from '../data/director.json';
import { ROLES } from '../lib/gangrim-policy.mjs';
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const api = import.meta.env.PUBLIC_GANGRIM_API_URL || '';
---
<Base lang={lang} path="/gangrim/" title="강림선생 · AI 사전검토" description="문서와 설명을 검토하고 보완한 뒤, 사람 강병준에게 최종 결정을 요청하는 AI 사전검토실입니다." section="gangrim">
  <div class="gangrim" data-api={api}>
    <section class="gr-hero wrap">
      <div class="gr-intro"><p class="eyebrow">DAL / DECISION REVIEW</p><h1>결정하기 전에,<br/><span>강림선생에게.</span></h1><p class="gr-lead">생각은 명확하게. 근거는 정확하게.<br/>문서와 설명을 검토하고 보완한 뒤,<br/>사람 강병준에게 최종 결정을 요청하세요.</p><div class="gr-chips"><span>정확성</span><span>성과</span><span>검증</span><span>마감 전 실행</span></div></div>
      <aside class="gr-person"><img src={director.photo.src} alt="강병준 AI 아바타 강림선생" width="180" height="180"/><div><span class="gr-live">AI 사전검토자</span><h2>강림선생</h2><p>강병준의 업무 원칙을 반영한 AI 아바타</p></div><blockquote>“근거를 확인하고, 판단의 이유를 설명하겠습니다. 최종 결정은 사람이 합니다.”</blockquote><small>실제 강병준 본인의 응답이 아닙니다.</small></aside>
    </section>
    <div class="wrap"><ol class="gr-flow" aria-label="검토 과정"><li><b>01</b> 자유 브리핑</li><li><b>02</b> 핵심 질문 하나</li><li><b>03</b> 약점·개선 방향</li><li><b>04</b> 강병준 최종 결정</li></ol></div>
    <section class="wrap gr-workspace">
      <div class="gr-tabs" role="tablist" aria-label="업무 선택"><button role="tab" aria-selected="true" data-panel="briefing-panel">회장님께 브리핑</button><button role="tab" aria-selected="false" data-panel="submit-panel">상세 양식</button><button role="tab" aria-selected="false" data-panel="lookup-panel">내 보고서 확인</button><button role="tab" aria-selected="false" data-panel="owner-panel">최종 결정함</button></div>
      <div id="connection" class="gr-connection" role="status">접수 서비스 연결 상태를 확인하고 있습니다.</div>
      <div id="notice" class="gr-notice" role="status" aria-live="polite" hidden></div>
      <Briefing />
      <div id="submit-panel" role="tabpanel" class="gr-panel" hidden>
        <div class="gr-panel-head"><div><p class="eyebrow">REPORT TO GANGRIM</p><h2>어떤 결정이 필요한가요?</h2><p>누구나 제출할 수 있습니다. 보고서는 다른 방문자에게 공개되지 않습니다.</p></div><button type="button" class="gr-outline" id="fill-example">작성 예시 채우기</button></div>
        <form id="report-form"><div class="gr-form-grid">
          <label class="gr-wide">보고 제목<input name="title" required maxlength="180" placeholder="예: 신규 진단 서비스 시범 운영 검토"/></label>
          <label>보고자<input name="author" required maxlength="100" autocomplete="name" placeholder="이름 또는 업무용 별칭"/></label>
          <label>검토 관점<select name="role" required>{ROLES.map(r=><option value={r}>{r}</option>)}</select></label>
          <label class="gr-wide">요청하는 의사결정<textarea name="question" required rows="2" maxlength="5000" placeholder="무엇을 승인·선택해야 하는지 구체적으로 적어주세요."></textarea></label>
          <label class="gr-wide">배경과 목표<textarea name="context" required rows="4" maxlength="16000" placeholder="현재 상황, 해결할 문제, 목표 성과와 성공 기준"></textarea></label>
          <label class="gr-wide">근거와 확인 결과<textarea name="evidence" required rows="4" maxlength="16000" placeholder="자료명·출처·확인 날짜·문서 페이지·수치 검증 결과. 미확인 정보는 구분해주세요."></textarea></label>
          <label>대안과 비교<textarea name="alternatives" required rows="4" maxlength="5000" placeholder="현 상태 유지안을 포함한 대안별 장단점·비용"></textarea></label>
          <label>위험과 대응<textarea name="risks" required rows="4" maxlength="5000" placeholder="주요 위험, 발생 시 영향, 대응·중단 조건"></textarea></label>
          <label>실행 계획<textarea name="plan" required rows="4" maxlength="5000" placeholder="책임자, 일정, 자원·예산, 실행 단계"></textarea></label>
          <label>검증 계획<textarea name="verification" required rows="4" maxlength="5000" placeholder="무엇을 어떻게 검증하며, 오류 수정 시간을 언제 확보하나요?"></textarea></label>
          <label>최종 마감<input name="deadline" type="datetime-local" required/></label>
          <label>첨부 문서 <span class="gr-muted">선택 · 최대 3개</span><input id="documents" type="file" multiple accept=".pdf,.docx,.txt,.md"/><small>PDF·DOCX·TXT·MD / 파일당 5MB, 합계 10MB. 이미지 PDF는 해석이 불완전할 수 있습니다.</small></label>
        </div>
        <p class="gr-privacy"><strong>현재 시험 운영 중입니다. 가상·비식별 자료로 테스트하고 개인정보·기밀은 제출하지 마세요.</strong> 접수 내용과 문서는 검토 서버에 저장되며, AI 검토를 요청하면 OpenAI API로 전달됩니다. 시험 자료는 자동 삭제되지 않으며, 삭제 요청은 사이트 문의 메뉴로 보내주세요. 타인의 개인정보와 제출 권한이 없는 자료는 제외해주세요. 조회키를 가진 사람과 최종 결정권자는 해당 보고서를 열람할 수 있습니다.</p>
        <label class="gr-check"><input name="consent" type="checkbox" required/> 문서 제출 권한이 있으며, 위 처리 안내를 확인했습니다.</label>
        <div class="gr-submit-row"><span id="form-mode">AI의 사전검토 통과는 최종 승인이 아닙니다.</span><button class="btn pri" type="submit" id="submit-report">보고서 접수 →</button></div></form>
      </div>
      <div id="lookup-panel" role="tabpanel" class="gr-panel" hidden><div class="gr-panel-head"><div><p class="eyebrow">PRIVATE REVIEW</p><h2>내 검토 확인</h2><p>접수 시 발급된 접수번호와 조회키가 필요합니다. 조회키는 다시 발급되지 않으므로 안전하게 보관하세요.</p></div></div><form id="lookup-form" class="gr-form-grid"><label>접수번호<input name="id" required autocomplete="off"/></label><label>조회키<input name="token" type="password" required autocomplete="off"/></label><button class="btn pri" type="submit">검토 불러오기</button></form><div id="case-result" hidden></div></div>
      <div id="owner-panel" role="tabpanel" class="gr-panel" hidden><div class="gr-panel-head"><div><p class="eyebrow">HUMAN DECISION</p><h2>강병준 최종 결정함</h2><p>최신 문서의 AI 사전검토를 통과하고 최종 결정을 요청한 보고서만 표시합니다.</p></div></div><form id="owner-form" class="gr-owner-login"><label>결정권자 인증키<input name="owner" type="password" autocomplete="off" required placeholder="운영자가 별도로 설정한 인증키"/></label><button class="btn sec" type="submit">최종 결정함 열기</button></form><p class="gr-muted">인증키는 이 탭을 닫으면 사라집니다. 제출자 조회키나 ChatGPT 비밀번호와 다릅니다.</p><div id="owner-queue"></div><div id="owner-result" hidden></div></div>
    </section>
    <section class="wrap gr-principles"><div><p class="eyebrow">HOW GANGRIM REVIEWS</p><h2>그럴듯한 답보다,<br/>검증 가능한 판단.</h2></div><div class="gr-principle-grid"><article><b>01 / 네 가지 관점</b><p>회사 경영 · AI 경영컨설팅 · 스타트업 투자 전략 · AI공학·경영학 연구.</p></article><article><b>02 / 근거와 불확실성</b><p>제출 자료를 검토하고 사실·추정·미확인을 구분합니다. 외부 사실을 확인하지 못하면 보완을 요청합니다.</p></article><article><b>03 / 보완 후 다시 검토</b><p>보고서나 문서가 바뀌면 이전 통과 상태는 무효입니다. 수정한 버전으로 다시 검토받습니다.</p></article><article><b>04 / 마지막 결정은 사람</b><p>강림선생은 검토 의견과 준비 상태를 제시합니다. 계약·투자·실행 승인과 외부 발송은 대신하지 않습니다.</p></article></div></section>
  </div>
  <script>import '../scripts/gangrim';</script>
</Base>
<style>
 .gangrim{--gr-soft:#a9a1c8}.gr-hero{display:grid;grid-template-columns:1.2fr 1fr;gap:72px;align-items:center;padding-top:76px;padding-bottom:56px}.gr-intro h1{font-size:clamp(40px,5.3vw,66px);line-height:1.18;margin:20px 0 24px}.gr-intro h1 span{color:var(--accent-3)}.gr-lead{font-size:19px;line-height:1.85;color:var(--fg-2)}.gr-chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}.gr-chips span{font-size:13px;border:1px solid var(--line-2);padding:6px 13px;border-radius:99px;color:var(--accent-3)}.gr-person{border:1px solid var(--line-2);border-radius:24px;padding:32px;background:radial-gradient(ellipse at top,rgba(139,92,246,.19),transparent),var(--surface);display:grid;grid-template-columns:100px 1fr;gap:22px;align-items:center}.gr-person img{width:100px;height:100px;object-fit:cover;border-radius:24px;background:#fff}.gr-person h2{font-size:28px;margin:7px 0}.gr-person p,.gr-person small{font-size:13px;color:var(--fg-2)}.gr-live{font-size:12px;letter-spacing:.08em;color:var(--mint)}.gr-live:before{content:'●';margin-right:7px}.gr-person blockquote{grid-column:1/-1;margin:0;padding-top:22px;border-top:1px solid var(--line);font-size:18px;line-height:1.8}.gr-person>small{grid-column:1/-1;color:var(--fg-3)}.gr-flow{list-style:none;padding:20px 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:18px;border:1px solid var(--line);border-radius:14px;margin:0;color:var(--fg-2);font-size:14px}.gr-flow b{color:var(--accent-t);margin-right:12px;font-size:12px}.gr-workspace{padding-top:48px;padding-bottom:30px}.gr-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}.gr-tabs button,.gr-outline{font:inherit;cursor:pointer;color:var(--fg-2);background:transparent;border:1px solid var(--line-2);border-radius:10px;padding:12px 20px}.gr-tabs button[aria-selected=true]{background:var(--accent-btn);color:white;border-color:var(--accent-btn)}.gr-connection{font-size:14px;color:var(--mint);padding:12px 0}.gr-connection[data-off=true]{color:#f6cf8e}.gr-panel{background:var(--surface);border:1px solid var(--line-2);border-radius:20px;padding:32px}.gr-panel-head{display:flex;justify-content:space-between;align-items:start;gap:20px;margin-bottom:30px}.gr-panel-head h2{font-size:28px;margin:10px 0}.gr-panel-head p:not(.eyebrow){color:var(--fg-2);font-size:14px}.gr-outline{font-size:13px;white-space:nowrap;padding:9px 14px}.gr-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.gr-wide{grid-column:1/-1}.gangrim label{display:flex;flex-direction:column;gap:9px;font-size:14px;font-weight:600}.gangrim input:not([type=checkbox]),.gangrim textarea,.gangrim select{width:100%;min-height:46px;background:#0c0626;color:var(--fg);border:1px solid var(--line-2);border-radius:9px;padding:12px 14px;font:400 15px/1.6 var(--font)}.gangrim textarea{resize:vertical}.gangrim input::placeholder,.gangrim textarea::placeholder{color:#aaa2c4}.gangrim input[type=file]{font-size:12px}.gangrim small{font-weight:400;line-height:1.7}.gr-privacy{font-size:13px;line-height:1.9;color:var(--fg-2);border-top:1px solid var(--line);padding-top:22px;margin-top:28px}.gangrim .gr-check{display:flex;flex-direction:row;align-items:flex-start;gap:10px;margin-top:14px;line-height:1.7}.gr-check input{margin-top:5px;accent-color:var(--accent)}.gr-submit-row{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:28px}.gr-submit-row span,.gr-muted{font-size:13px;font-weight:400;color:var(--fg-3)}.gr-principles{display:grid;grid-template-columns:1fr 1.5fr;gap:60px;padding-top:56px}.gr-principles h2{font-size:30px;line-height:1.5;margin-top:12px}.gr-principle-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.gr-principle-grid b{font-size:14px;color:var(--accent-3)}.gr-principle-grid p{font-size:14px;color:var(--fg-2);margin-top:10px;line-height:1.9}.gr-notice{padding:16px 20px;margin:12px 0;border:1px solid var(--line-2);background:#201139;border-radius:12px;white-space:pre-wrap}.gr-owner-login{display:flex;gap:16px;align-items:end;margin-bottom:16px}.gr-owner-login label{flex:1}.gangrim :global(.gr-result){border-top:1px solid var(--line-2);margin-top:28px;padding-top:24px;display:grid;gap:16px}.gangrim :global(.gr-result h3){font-size:22px}.gangrim :global(.gr-result h4){font-size:16px;color:var(--accent-3)}.gangrim :global(.gr-result p),.gangrim :global(.gr-result li){white-space:pre-wrap;overflow-wrap:anywhere;color:var(--fg-2);font-size:15px}.gangrim :global(.gr-result ul){margin:0;padding-left:22px}.gangrim :global(.gr-result pre){white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.8 var(--font);background:#0c0626;border-radius:8px;padding:16px}.gangrim :global(.gr-actions){display:flex;flex-wrap:wrap;gap:10px}.gangrim :global(.gr-state){color:var(--mint);font-weight:600}.gangrim :global(.gr-queue-item){width:100%;padding:18px;text-align:left;background:var(--surface-2);color:var(--fg);border:1px solid var(--line-2);border-radius:9px;margin-top:12px;font:inherit;cursor:pointer}.gangrim button:disabled{opacity:.5;cursor:not-allowed}.gangrim :global(.gr-review-note){padding:14px;border-left:3px solid var(--accent);background:var(--surface-2)}@media(max-width:800px){.gr-hero{grid-template-columns:1fr;gap:32px;padding-top:45px}.gr-flow{grid-template-columns:1fr 1fr}.gr-principles{grid-template-columns:1fr;gap:28px}.gr-panel{padding:22px}.gr-panel-head{flex-direction:column}.gr-form-grid{grid-template-columns:1fr}.gr-wide{grid-column:auto}.gr-submit-row,.gr-owner-login{flex-direction:column;align-items:stretch}.gr-owner-login label{width:100%}.gr-person{padding:24px}}@media(max-width:440px){.gr-person{grid-template-columns:72px 1fr;gap:16px}.gr-person img{width:72px;height:72px}.gr-person h2{font-size:24px}.gr-flow{padding:16px;font-size:12px;gap:12px}.gr-principle-grid{grid-template-columns:1fr}}
</style>
