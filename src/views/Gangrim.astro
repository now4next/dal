---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import type {Lang} from '../lib/i18n';
interface Props {lang:Lang}
const {lang}=Astro.props;
const ko=lang==='ko';
const t=(a:string,b:string)=>ko?a:b;
---
<Base lang={lang} path="/aiagent/" section="gangrim" title={t('AI 에이전트 · DAL','AI Agents · DAL')} description={t('전문가의 판단 기준을 조직의 AI 에이전트로 구현합니다. 의사결정 에이전트 체험과 맞춤 개발 상담.','Turn expert judgment into AI agents for your organization. Explore a decision agent and discuss a custom build.')}>
<div class="showroom wrap" data-lang={lang} data-email={site.email}>
<header class="intro"><span class="eyebrow">DAL · AI AGENTS</span><h1>{t('더 나은 판단을 만드는','Better decisions,')}<br/><span>{t('AI 에이전트','built into your workflow.')}</span></h1><p>{t('DAL 연구소와 강병준 대표의 전문 역량을 조직의 AI 에이전트로 연결합니다.','AI agents grounded in the expertise of DAL and Byung Jun Kang.')}</p><p class="muted">{t('핵심을 질문하고, 근거를 검토하고, 의사결정을 준비합니다.','Question assumptions. Examine evidence. Prepare decisions.')}</p><div class="actions"><a class="btn pri" href="#experience">{t('2분 체험','Try the demo')}</a><a class="btn sec" href="#deliverable">{t('결과물 보기','View deliverables')}</a><a class="text-link" href="#inquiry">{t('맞춤 개발 문의 ↗','Discuss a custom build ↗')}</a></div></header>
<section id="experience" class="demo-section"><div class="section-title"><div><span class="eyebrow">DECISION AGENT</span><h2>{t('대표(회장,C레벨) 보고하기','Brief the CEO, Chair or C-suite')}</h2></div><span class="badge">{t('시뮬레이션','Simulation')}</span></div><p class="notice">{t('가상 사례와 사전 작성된 응답으로 체험합니다. 실제 AI 분석·자료 업로드·대표 전달은 수행하지 않습니다.','Explore fictional cases with curated responses. No live AI analysis, file uploads or actual executive handoff.')}</p><div class="cases" role="group" aria-label={t('사례 선택','Choose a case')}></div><div class="demo-grid"><div><div id="conversation" aria-live="polite"></div><div id="choices" class="choices"></div><button id="restart" type="button" class="text-link">{t('이 사례 다시 체험','Restart this case')}</button></div><aside class="score-panel"><span class="eyebrow">{t('보고 준비도 · 예시','REPORT READINESS · EXAMPLE')}</span><p class="score"><strong id="total">60</strong><span>/ 100</span></p><p id="score-state" role="status"></p><div id="criteria"></div><p class="fine">{t('95점은 대표 검토 요청 기준의 예시이며, 사업 성공 확률이나 승인 보장이 아닙니다.','95 is an illustrative handoff threshold, not a probability of success or a guarantee of approval.')}</p></aside></div></section>
<section id="deliverable"><div class="section-title"><div><span class="eyebrow">DELIVERABLE PREVIEW</span><h2>{t('판단에 필요한 결과물','What a decision-ready report looks like')}</h2></div></div><p class="muted">{t('선택한 사례의 보완 완료 보고서 예시입니다. 체험 진행 여부와 관계없이 확인할 수 있습니다.','A completed example for the selected case, available at any point in the demo.')}</p><article class="report"><div class="report-top"><span id="report-case"></span><span class="badge">{t('가상 결과물','Illustrative output')}</span></div><h3>{t('대표 보고 핵심 요약','Executive summary')}</h3><p id="report-summary"></p><details><summary>{t('근거·실행 계획·남은 위험 보기','Evidence, execution plan and remaining risks')}</summary><h4>{t('핵심 근거','Key evidence')}</h4><p id="report-evidence"></p><h4>{t('실행과 검증','Execution and verification')}</h4><p id="report-plan"></p><h4>{t('남은 불확실성','Remaining uncertainty')}</h4><p id="report-risk"></p></details><div class="actions"><button id="download" class="btn sec" type="button">{t('보고서 예시 다운로드','Download sample report')}</button><button id="decision" class="text-link" type="button" aria-expanded="false" aria-controls="decision-result">{t('의사결정 결과 예시 보기','View example decision')}</button></div><p id="decision-result" hidden></p></article></section>
<section id="inquiry"><div class="section-title"><div><span class="eyebrow">BUILD WITH DAL</span><h2>{t('우리 조직에 맞는 에이전트','An agent built for your organization')}</h2></div></div><p class="muted">{t('업무와 판단 기준을 알려주시면, 적용 범위와 검증 방법을 함께 설계합니다.','Tell us about your workflow and decision criteria. Together, we can define scope and validation.')}</p><form id="inquiry-form"><div class="form-grid"><label>{t('관심 분야','Area of interest')}<select name="agent"><option>{t('의사결정 에이전트','Decision agent')}</option><option>{t('연구 논문 심사 에이전트','Research review agent')}</option><option>{t('투자 분석 에이전트','Investment analysis agent')}</option><option>{t('경영컨설팅 에이전트','Management consulting agent')}</option><option>{t('기타 맞춤 에이전트','Other custom agent')}</option></select></label><label>{t('이름 / 조직','Name / organization')}<input name="name" required maxlength="100" autocomplete="organization"/></label></div><label>{t('해결하려는 업무와 사용하는 자료','Workflow to improve and available materials')}<textarea name="need" required maxlength="2000" rows="3" placeholder={t('예: 신규 사업 승인 검토 / 사업계획서, 매출 데이터','e.g. New venture approvals / business plans and sales data')}></textarea></label><label>{t('회신 이메일','Reply email')}<input name="reply" type="email" required maxlength="200" autocomplete="email"/></label><p class="fine">{t('입력 내용은 이 페이지에서 서버로 전송하거나 저장하지 않습니다. 메일 앱에서 내용을 확인한 뒤 직접 전송해 주세요. 민감한 자료는 첨부하지 마세요.','This page does not send or store your entries on a server. Review and send the draft in your email app. Please omit sensitive materials.')}</p><div class="actions"><button class="btn pri" type="submit">{t('문의 메일 작성','Prepare inquiry email')}</button><button id="copy-inquiry" class="btn sec" type="button">{t('문의 내용 복사','Copy inquiry')}</button><a href={`mailto:${site.email}`}>{site.email}</a></div><p id="inquiry-status" role="status"></p></form><p class="roadmap">{t('확장 준비 중: 연구 논문 심사 · 투자 분석 · 경영컨설팅','In development: Research review · Investment analysis · Management consulting')}</p></section>
</div><script>import '../scripts/agent-showroom';</script>
</Base>
<style>
.showroom{padding-top:48px;padding-bottom:70px;max-width:1100px}.showroom section{padding:42px 0;border-top:1px solid var(--line);scroll-margin-top:110px}.intro{padding:20px 0 48px;max-width:850px}.intro h1{font-size:clamp(34px,5vw,55px);line-height:1.2;letter-spacing:-.035em;margin:18px 0 22px}.intro h1 span{color:var(--accent-3)}.intro p{line-height:1.8;margin:6px 0}.muted,.notice,.fine{color:var(--fg-2);line-height:1.8}.notice,.fine{font-size:13px}.actions{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:23px}.text-link{border:0;background:none;color:var(--accent-3);font:inherit;cursor:pointer;text-decoration:underline;text-underline-offset:5px;padding:8px 0}.section-title{display:flex;justify-content:space-between;align-items:center;gap:16px}.section-title h2{font-size:clamp(23px,3vw,30px);margin:8px 0}.badge{font-size:12px;border:1px solid var(--line-2);border-radius:30px;padding:6px 12px;white-space:nowrap;color:var(--mint)}.demo-grid{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:28px;margin-top:24px}.score-panel,.report{padding:26px;background:var(--surface);border:1px solid var(--line);border-radius:16px;min-width:0}.score{display:flex;align-items:baseline;gap:10px;margin:12px 0}.score strong{font-size:56px;line-height:1.1}.score span{color:var(--fg-3)}.report-top{display:flex;justify-content:space-between;gap:14px;align-items:center}.report h3{margin:22px 0 12px}.report p{line-height:1.85}.report details{margin-top:22px;border-top:1px solid var(--line);padding-top:16px}.report h4{margin:20px 0 6px;color:var(--accent-3)}summary{cursor:pointer;line-height:1.7}#decision-result{border-left:2px solid var(--mint);padding:12px 18px;margin-top:20px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}form{max-width:800px}label{display:block;font-size:14px;margin:18px 0 8px}input,select,textarea{display:block;width:100%;background:var(--bg-2);border:1px solid var(--line-2);border-radius:8px;padding:12px;margin-top:8px;color:var(--fg);font:inherit}textarea{resize:vertical}.roadmap{margin-top:35px;font-size:14px;color:var(--fg-3)}[hidden]{display:none!important}@media(max-width:700px){.showroom{padding-top:24px}.demo-grid,.form-grid{grid-template-columns:1fr}.score-panel{padding:20px}.section-title{align-items:flex-start}.report{padding:20px}.actions{gap:12px}.actions .btn{font-size:14px}.intro{padding-bottom:32px}.showroom section{padding:30px 0}}
</style>
<style is:global>
.showroom .cases{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0}.showroom .cases button{border:1px solid var(--line-2);border-radius:30px;padding:10px 17px;background:transparent;color:var(--fg-2);font:inherit;cursor:pointer}.showroom .cases button[aria-pressed=true]{background:var(--accent-btn);color:white;border-color:var(--accent-btn)}.showroom .bubble{padding:20px;margin:0 0 14px;border:1px solid var(--line);border-radius:12px;line-height:1.8;background:var(--surface)}.showroom .bubble p{margin:8px 0 0}.showroom .bubble small{display:block;margin-bottom:8px;color:var(--fg-3)}.showroom .bubble.chair{border-left:3px solid var(--accent);background:var(--surface-2)}.showroom .bubble.chair strong{font-size:19px;line-height:1.7}.showroom .choices{display:grid;gap:10px}.showroom .choices button{font:inherit;text-align:left;line-height:1.6;border:1px solid var(--line-2);border-radius:10px;padding:14px 18px;background:transparent;color:var(--fg);cursor:pointer}.showroom .choices button:hover{background:var(--surface-2)}.showroom .criterion{border-top:1px solid var(--line);padding:12px 0}.showroom .criterion>div{display:flex;justify-content:space-between;gap:10px;font-size:14px}.showroom .criterion p{font-size:12px;line-height:1.7;color:var(--fg-2);margin:7px 0 0}.showroom button:focus-visible,.showroom a:focus-visible{outline:2px solid var(--mint);outline-offset:4px}
</style>
