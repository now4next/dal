---
import Base from '../layouts/Base.astro';
import {type Lang} from '../lib/i18n';
interface Props {lang:Lang}
const {lang}=Astro.props,ko=lang==='ko';
const services=ko?['경영컨설팅 및 조직재설계','진단·평가·설문 온라인 운영 지원 서비스','데이터 분석 및 대시보드 서비스','AI 티칭·코칭·멘토링 챗봇 서비스','고객맞춤형 AI에이전트 서비스(진단, 분석, 피드백)']:['Management consulting & organization redesign','Online operations for assessments, evaluations & surveys','Data analytics & dashboards','AI teaching, coaching & mentoring chatbots','Custom AI agents for assessment, analysis & feedback'];
const chat='https://nfn-diagnosis-consultation.aronpure.chatgpt.site/live';
---
<Base lang={lang} path="/marketing/customer/" title={ko?'고객 상담·서비스':'Customer services'}>
 <header class="page-head"><div class="wrap"><span class="eyebrow">NFN · CUSTOMER SERVICES</span><h1>{ko?'지금 필요한 것부터, 함께 정리합니다.':'Start with what you need today.'}</h1><p>{ko?'진단을 준비하고 계신가요? 데이터를 어떻게 활용할지, AI를 어디에 적용할지 고민 중이신가요? 강림 PD에게 현재 상황과 궁금한 점을 편하게 남겨주세요.':'Planning an assessment, exploring your data or considering AI? Share your current situation and questions with Kangrim PD.'}</p><div class="actions"><a class="btn pri" href={chat} target="_blank" rel="noopener noreferrer">{ko?'강림 PD와 라이브 상담 ↗':'Start a consultation ↗'}</a><a class="btn sec" href="https://nfn-diagnosis-consultation.aronpure.chatgpt.site/" target="_blank" rel="noopener noreferrer">{ko?'진단별 제안·미팅 요청 ↗':'Assessment proposals & meeting request ↗'}</a></div><p class="hours">{ko?'오전 9시~오후 9시(한국 시간). 부재중에는 메시지를 남겨주세요. 답변 알림 이메일에서 같은 대화로 돌아올 수 있습니다.':'09:00–21:00 KST. Leave a message while we are away; reply notifications take you back to the same conversation. Consultation opens in NFN’s dedicated service.'}</p></div></header>
 <section><div class="wrap service-grid"><div><span class="eyebrow">ABOUT NFN</span><h2>{ko?'경영의 질문을 데이터와 실행으로 연결합니다.':'Connect business questions to data and action.'}</h2><p>{ko?'NFN은 경영컨설팅 기반의 비즈니스 인텔리전스(BI) 전문기업입니다. 고객의 상황에 맞춰 컨설팅, 진단 운영, 데이터 분석과 AI 서비스를 함께 설계합니다.':'NFN is a business intelligence company grounded in management consulting. We combine consulting, assessment operations, analytics and AI around each client’s needs.'}</p></div><ol class="service-list">{services.map((s,i)=><li><span>0{i+1}</span><strong>{s}</strong></li>)}</ol></div></section>
 <section><div class="wrap card prompt-card"><span class="eyebrow">YOUR NEXT QUESTION</span><h2>{ko?'어떤 상황에 가까우신가요?':'Which situation sounds familiar?'}</h2><div class="question-grid">{(ko?['리더십다면·조직·컴플라이언스·안전문화 진단을 준비하고 있습니다.','기존 조사 결과를 분석하고, 대시보드와 후속 실행으로 연결하고 싶습니다.','AI 코칭이나 맞춤형 에이전트를 검토 중인데, 무엇부터 시작할지 고민입니다.']:['We are planning a leadership, organization, compliance or safety culture assessment.','We want to turn survey results into analysis, dashboards and follow-up actions.','We are considering AI coaching or custom agents and need a starting point.']).map(t=><p>{t}</p>)}</div><p>{ko?'정리된 제안요청서가 없어도 괜찮습니다. 대상·목적·희망 일정과 지금 가장 어려운 점을 알려주세요.':'No formal brief is needed. Tell us about your audience, purpose, timeline and biggest challenge.'}</p><a class="btn pri" href={chat} target="_blank" rel="noopener noreferrer">{ko?'현재 고민 남기기 ↗':'Share your question ↗'}</a></div></section>
 <section><div class="wrap platform-links"><a href="https://globalassess.net/" target="_blank" rel="noopener">Global Assess · Assessment SaaS Platform ↗</a><a href="mailto:now@nfn.co.kr">now@nfn.co.kr</a><span>PD · Platform Director 강림 PD</span></div></section>
</Base>
<style>.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}.hours{font-size:14px!important;color:var(--fg-2);max-width:760px}.service-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px}.service-list{list-style:none;padding:0;margin:0}.service-list li{display:flex;gap:18px;align-items:center;border-bottom:1px solid var(--line);padding:18px 0}.service-list span{color:var(--mint);font-size:13px}.prompt-card{padding:32px}.question-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.question-grid p{background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:20px}.platform-links{display:flex;gap:24px;flex-wrap:wrap;color:var(--fg-2)}@media(max-width:760px){.service-grid,.question-grid{grid-template-columns:1fr;gap:20px}.prompt-card{padding:22px}}</style>
