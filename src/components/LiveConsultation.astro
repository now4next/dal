---
interface Props { lang: 'ko'|'en' }
const ko=Astro.props.lang==='ko';
---
<a class="live-consultation" href="https://nfn-diagnosis-consultation.aronpure.chatgpt.site/live" target="_blank" rel="noopener noreferrer" aria-label={ko?'강림 PD 라이브 상담 · 새 창':'Live consultation with Kangrim PD · new tab'}>
 <span class="pd-avatar" aria-hidden="true">PD</span><span><strong>{ko?'강림 PD 라이브 상담':'Chat with Kangrim PD'} <span aria-hidden="true">↗</span></strong><small>{ko?'09–21시 · 부재중 메시지 접수':'09:00–21:00 KST · Leave a message'}</small></span>
</a>
<style>
 .live-consultation{position:fixed;right:24px;bottom:max(24px,env(safe-area-inset-bottom));z-index:90;display:flex;align-items:center;gap:11px;background:#32166a;color:#fff;border:1px solid #b8a4fd;border-radius:18px;padding:13px 17px;box-shadow:0 8px 28px #0008;text-decoration:none;max-width:calc(100vw - 32px)}
 .live-consultation strong{font-size:15px;display:block}.live-consultation small{display:block;font-size:12px;color:#e1d8f7;margin-top:3px}.pd-avatar{display:grid;place-items:center;width:37px;height:37px;border-radius:50%;background:#e6dcff;color:#32166a;font-size:13px;font-weight:800;flex-shrink:0}.live-consultation:hover{background:#46218b}.live-consultation:focus-visible{outline:3px solid #5eead4;outline-offset:4px}
 @media(max-width:600px){.live-consultation{right:16px;bottom:max(16px,env(safe-area-inset-bottom));padding:10px 13px}.live-consultation strong{font-size:14px}.live-consultation small{font-size:11px}}
</style>
