---
/* Lucide icons (ISC). Only the icons listed here are bundled into the page HTML. */
import chartLine from 'lucide-static/icons/chart-line.svg?raw';
import userSearch from 'lucide-static/icons/user-search.svg?raw';
import clipboardCheck from 'lucide-static/icons/clipboard-check.svg?raw';
import shieldCheck from 'lucide-static/icons/shield-check.svg?raw';
import messagesSquare from 'lucide-static/icons/messages-square.svg?raw';
import workflow from 'lucide-static/icons/workflow.svg?raw';
import fileText from 'lucide-static/icons/file-text.svg?raw';
import badgeCheck from 'lucide-static/icons/badge-check.svg?raw';
import bookOpen from 'lucide-static/icons/book-open.svg?raw';
import graduationCap from 'lucide-static/icons/graduation-cap.svg?raw';
import briefcase from 'lucide-static/icons/briefcase.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import copy from 'lucide-static/icons/copy.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowLeft from 'lucide-static/icons/arrow-left.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import menu from 'lucide-static/icons/menu.svg?raw';
import building2 from 'lucide-static/icons/building-2.svg?raw';
import users from 'lucide-static/icons/users.svg?raw';
import newspaper from 'lucide-static/icons/newspaper.svg?raw';
import layers from 'lucide-static/icons/layers.svg?raw';
import network from 'lucide-static/icons/network.svg?raw';
import brain from 'lucide-static/icons/brain.svg?raw';
import sparkles from 'lucide-static/icons/sparkles.svg?raw';
import landmark from 'lucide-static/icons/landmark.svg?raw';
import handshake from 'lucide-static/icons/handshake.svg?raw';
import award from 'lucide-static/icons/award.svg?raw';
import calendar from 'lucide-static/icons/calendar.svg?raw';
import userIcon from 'lucide-static/icons/user.svg?raw';
import megaphone from 'lucide-static/icons/megaphone.svg?raw';

const ICONS: Record<string, string> = {
  'chart-line': chartLine, 'user-search': userSearch, 'clipboard-check': clipboardCheck,
  'shield-check': shieldCheck, 'messages-square': messagesSquare, workflow,
  'file-text': fileText, 'badge-check': badgeCheck, 'book-open': bookOpen,
  'graduation-cap': graduationCap, briefcase, 'map-pin': mapPin, mail, copy, check,
  'arrow-right': arrowRight, 'arrow-left': arrowLeft, 'arrow-up-right': arrowUpRight, menu,
  'building-2': building2, users, newspaper, layers, network, brain, sparkles,
  landmark, handshake, award, calendar, user: userIcon, megaphone,
};

interface Props { name: string; size?: number; stroke?: number; class?: string }
const { name, size = 22, stroke = 1.75, class: cls = '' } = Astro.props;
const raw = ICONS[name];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const svg = raw
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/class="[^"]*"/, `class="icon ${cls}"`)
  .replace('width="24"', `width="${size}"`)
  .replace('height="24"', `height="${size}"`)
  .replace('stroke-width="2"', `stroke-width="${stroke}"`)
  .replace('<svg', '<svg aria-hidden="true" focusable="false"')
  .trim();
---
<Fragment set:html={svg} />
