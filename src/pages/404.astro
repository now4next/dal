---
import Base from '../layouts/Base.astro';
---
<Base lang="en" path="/" title="Page not found">
  <header class="page-head">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>Page not found · 페이지를 찾을 수 없습니다</h1>
      <p>The page may have moved. 주소가 바뀌었을 수 있습니다.</p>
      <p><a class="btn pri" href="/">Home</a> <a class="btn sec" href="/ko/">홈 (한국어)</a></p>
    </div>
  </header>
</Base>
