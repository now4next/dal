{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dal-gangrim-api",
  "main": "index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://dal.fyi", "DAILY_AI_LIMIT": "0", "LIVE_AI_ENABLED": "false" },
  "d1_databases": [{ "binding": "DB", "database_name": "dal-gangrim", "database_id": "645ce82b-00b7-417c-9ea6-6ae858940b14", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "dal-gangrim-private" }]
}
